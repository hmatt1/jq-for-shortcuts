{
 "cases": [
  {
   "name": "R4.5 a 64-bit integer ID passes through unchanged",
   "filter": ".id",
   "input": "{\"id\": 1234567890123456789}",
   "outputs": [
    "1234567890123456789"
   ]
  },
  {
   "name": "R4.5 number literals keep their digits",
   "filter": ".",
   "input": "{\"price\": 1.000, \"big\": 100000000000000000000}",
   "outputs": [
    "{\"price\":1.000,\"big\":100000000000000000000}"
   ]
  },
  {
   "name": "R4.5 arithmetic converts to doubles",
   "filter": ".id + 1",
   "input": "{\"id\": 1234567890123456789}",
   "outputs": [
    "1234567890123456800"
   ]
  },
  {
   "name": "R5.7 non-ASCII text is not escaped",
   "filter": ".name",
   "input": "{\"name\": \"Chloé 😀 東京\"}",
   "outputs": [
    "\"Chloé 😀 東京\""
   ]
  },
  {
   "name": "R5.6 a filter with no output is not an error",
   "filter": ".[] | select(. > 10)",
   "input": "[1, 2, 3]",
   "outputs": []
  },
  {
   "name": "R4.6 object keys keep insertion order",
   "filter": "{z: 1, a: 2, m: 3}",
   "input": "null",
   "outputs": [
    "{\"z\":1,\"a\":2,\"m\":3}"
   ]
  },
  {
   "name": "R4.6 sort keys sorts every object",
   "filter": ".",
   "input": "{\"b\": {\"y\": 1, \"x\": 2}, \"a\": 0}",
   "sortKeys": true,
   "outputs": [
    "{\"a\":0,\"b\":{\"x\":2,\"y\":1}}"
   ]
  },
  {
   "name": "R2.3 several input values run one at a time",
   "filter": ".a",
   "input": "{\"a\": 1}\n{\"a\": 2}\n{\"a\": 3}",
   "outputs": [
    "1",
    "2",
    "3"
   ]
  },
  {
   "name": "R2.3 slurp runs once over all values",
   "filter": "map(.a) | add",
   "input": "{\"a\": 1} {\"a\": 2}",
   "slurp": true,
   "outputs": [
    "3"
   ]
  },
  {
   "name": "R2.4 a byte order mark is ignored",
   "filter": ".a",
   "input": "﻿{\"a\": \"bom\"}",
   "outputs": [
    "\"bom\""
   ]
  },
  {
   "name": "R2.9 arguments keep their types",
   "filter": "[$text, $number, $flag, $list, $object]",
   "input": "null",
   "arguments": {
    "text": "\"hi\"",
    "number": "42",
    "flag": "true",
    "list": "[1,2]",
    "object": "{\"k\":\"v\"}"
   },
   "outputs": [
    "[\"hi\",42,true,[1,2],{\"k\":\"v\"}]"
   ]
  },
  {
   "name": "R2.7 arguments appear in $ARGS.named",
   "filter": "$ARGS.named",
   "input": "null",
   "arguments": {
    "limit": "2"
   },
   "outputs": [
    "{\"limit\":2}"
   ]
  },
  {
   "name": "R4.10 halt returns the results so far",
   "filter": ".[] | if . == 3 then halt else . end",
   "input": "[1, 2, 3, 4]",
   "outputs": [
    "1",
    "2"
   ]
  },
  {
   "name": "R4.10 halt_error stops with its message",
   "filter": "\"stop here\" | halt_error",
   "input": "null",
   "error": {
    "type": "halt",
    "message": "stop here"
   }
  },
  {
   "name": "try and catch handle errors",
   "filter": ".[] | try error(\"bad \\(.)\") catch .",
   "input": "[1, 2]",
   "outputs": [
    "\"bad 1\"",
    "\"bad 2\""
   ]
  },
  {
   "name": "optional iteration skips a missing list",
   "filter": "[.items[]?]",
   "input": "{}",
   "outputs": [
    "[]"
   ]
  },
  {
   "name": "R4.11 test matches a regular expression",
   "filter": "map(test(\"^a.c$\"))",
   "input": "[\"abc\", \"abd\", \"aXc\"]",
   "outputs": [
    "[true,false,true]"
   ]
  },
  {
   "name": "R4.11 match reports offsets",
   "filter": "[match(\"b+\"; \"g\") | {offset, length}]",
   "input": "\"abbcb\"",
   "outputs": [
    "[{\"offset\":1,\"length\":2},{\"offset\":4,\"length\":1}]"
   ]
  },
  {
   "name": "R4.11 match offsets count code points",
   "filter": "[match(\"ö\"; \"g\").offset]",
   "input": "\"aöbö\"",
   "outputs": [
    "[1,3]"
   ]
  },
  {
   "name": "R4.11 capture builds an object",
   "filter": "capture(\"(?<y>\\\\d{4})-(?<m>\\\\d{2})\")",
   "input": "\"2026-10\"",
   "outputs": [
    "{\"y\":\"2026\",\"m\":\"10\"}"
   ]
  },
  {
   "name": "R4.11 sub and gsub replace text",
   "filter": "sub(\"o\"; \"0\"), gsub(\"o\"; \"0\")",
   "input": "\"foo boo\"",
   "outputs": [
    "\"f0o boo\"",
    "\"f00 b00\""
   ]
  },
  {
   "name": "R4.11 gsub can use named groups",
   "filter": "gsub(\"(?<d>\\\\d)\"; \"<\\(.d)>\")",
   "input": "\"a1b2\"",
   "outputs": [
    "\"a<1>b<2>\""
   ]
  },
  {
   "name": "R4.11 the i flag ignores case",
   "filter": "test(\"HELLO\"; \"i\")",
   "input": "\"hello world\"",
   "outputs": [
    "true"
   ]
  },
  {
   "name": "R4.11 the x flag allows comments in patterns",
   "filter": "test(\"a b # spaces ignored\"; \"x\")",
   "input": "\"ab\"",
   "outputs": [
    "true"
   ]
  },
  {
   "name": "R4.11 splits with a regex",
   "filter": "[splits(\", *\")]",
   "input": "\"a, b,c\"",
   "outputs": [
    "[\"a\",\"b\",\"c\"]"
   ]
  },
  {
   "name": "R4.11 scan finds every match",
   "filter": "[scan(\"\\\\d+\")]",
   "input": "\"a1b22c333\"",
   "outputs": [
    "[\"1\",\"22\",\"333\"]"
   ]
  },
  {
   "name": "dates format in UTC",
   "filter": "strftime(\"%Y-%m-%dT%H:%M:%S%z\")",
   "input": "1700000000",
   "outputs": [
    "\"2023-11-14T22:13:20+0000\""
   ]
  },
  {
   "name": "dates round-trip through ISO 8601",
   "filter": "todate, (todate | fromdate)",
   "input": "1780000000",
   "outputs": [
    "\"2026-05-28T20:26:40Z\"",
    "1780000000"
   ]
  },
  {
   "name": "$__loc__ gives the line",
   "filter": "$__loc__",
   "input": "null",
   "outputs": [
    "{\"file\":\"<top-level>\",\"line\":1}"
   ]
  },
  {
   "name": "R4.3 a syntax error reports its position",
   "filter": ".foo | | .bar",
   "input": "{}",
   "error": {
    "type": "compile",
    "offset": 7
   }
  },
  {
   "name": "R4.2 an empty filter is an error",
   "filter": "  ",
   "input": "{}",
   "error": {
    "type": "compile",
    "kind": "emptyFilter"
   }
  },
  {
   "name": "R2.10 an undefined variable is a compile error",
   "filter": ".a + $limit",
   "input": "{}",
   "error": {
    "type": "compile",
    "kind": "undefinedVariable",
    "name": "limit"
   }
  },
  {
   "name": "R4.4 a run-time error names the operation and type",
   "filter": ".items[] | .name",
   "input": "{\"items\": null}",
   "error": {
    "type": "runtime",
    "message": "Cannot iterate over null (null)"
   }
  },
  {
   "name": "R4.4 results before a run-time error are kept",
   "filter": ".[] | .name",
   "input": "[{\"name\": \"a\"}, 5]",
   "outputs": [
    "\"a\""
   ],
   "error": {
    "type": "runtime",
    "message": "Cannot index number with string \"name\""
   }
  },
  {
   "name": "R8.3 input that is not valid JSON",
   "filter": ".",
   "input": "{\"a\": [1, 2}",
   "error": {
    "type": "input"
   }
  },
  {
   "name": "R4.7 the disabled feature env does not compile: env.HOME",
   "filter": "env.HOME",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "env"
   }
  },
  {
   "name": "R4.7 the disabled feature $ENV does not compile: $ENV.HOME",
   "filter": "$ENV.HOME",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "$ENV"
   }
  },
  {
   "name": "R4.7 the disabled feature input does not compile: [., input]",
   "filter": "[., input]",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "input"
   }
  },
  {
   "name": "R4.7 the disabled feature inputs does not compile: [inputs]",
   "filter": "[inputs]",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "inputs"
   }
  },
  {
   "name": "R4.7 the disabled feature input_filename does not compile: input_filename",
   "filter": "input_filename",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "input_filename"
   }
  },
  {
   "name": "R4.7 the disabled feature include does not compile: include \"lib\"; .",
   "filter": "include \"lib\"; .",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "include"
   }
  },
  {
   "name": "R4.7 the disabled feature import does not compile: import \"lib\" as lib; .",
   "filter": "import \"lib\" as lib; .",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "import"
   }
  },
  {
   "name": "R4.7 the disabled feature import does not compile: import \"data\" as $d; .",
   "filter": "import \"data\" as $d; .",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "import"
   }
  },
  {
   "name": "R4.7 the disabled feature modulemeta does not compile: \"lib\" | modulemeta",
   "filter": "\"lib\" | modulemeta",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "modulemeta"
   }
  },
  {
   "name": "R4.7 the disabled feature get_search_list does not compile: get_search_list",
   "filter": "get_search_list",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "get_search_list"
   }
  },
  {
   "name": "R4.7 the disabled feature get_prog_origin does not compile: get_prog_origin",
   "filter": "get_prog_origin",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "get_prog_origin"
   }
  },
  {
   "name": "R4.7 the disabled feature get_jq_origin does not compile: get_jq_origin",
   "filter": "get_jq_origin",
   "input": "null",
   "error": {
    "type": "disabled",
    "feature": "get_jq_origin"
   }
  },
  {
   "name": "R4.8 a runaway filter stops at the timeout",
   "filter": "[range(1e12)]",
   "input": "null",
   "timeout": 0.5,
   "error": {
    "type": "timeout"
   }
  },
  {
   "name": "R4.8 an endless generator stops at the timeout",
   "filter": "last(range(1e12))",
   "input": "null",
   "timeout": 0.5,
   "error": {
    "type": "timeout"
   }
  },
  {
   "name": "R4.8 unbounded recursion stops",
   "filter": "def f: f + 1; f",
   "input": "null",
   "timeout": 20,
   "error": {
    "type": "recursion"
   }
  },
  {
   "name": "R4.8 one huge string stops at the memory limit",
   "filter": "\"x\" * 1e9 | length",
   "input": "null",
   "timeout": 10,
   "maxCollectionSize": 10000000,
   "error": {
    "type": "memory"
   }
  },
  {
   "name": "R4.8 a catastrophic regular expression stops at the timeout",
   "filter": "test(\"(a+)+$\")",
   "input": "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!\"",
   "timeout": 1,
   "error": {
    "type": "timeout"
   }
  }
 ]
}
